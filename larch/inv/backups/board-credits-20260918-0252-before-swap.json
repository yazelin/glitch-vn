{"id": "board-credits", "kind": "story", "mode": "story", "name": "謝幕", "edges": [{"id": "credits-e0", "source": "credits-hud", "target": "credits-hall"}, {"id": "credits-e1", "source": "credits-hall", "target": "credits-end"}, {"id": "credits-e2", "source": "credits-end", "target": "credits-roll"}, {"id": "credits-e3", "source": "credits-roll", "target": "credits-bow"}, {"id": "credits-e4", "source": "credits-bow", "target": "credits-line"}, {"id": "edge-story-cg-unlock-curtain-enter", "data": {"condition": {"op": "eq", "kind": "variable", "match": "all", "value": false, "variable": "__larch_cg__:4y-1vo7exn", "conditions": [{"op": "eq", "value": false, "variable": "__larch_cg__:4y-1vo7exn", "variableLabel": "調查篇・謝幕"}], "variableLabel": "調查篇・謝幕"}}, "source": "credits-line", "target": "story-cg-unlock-curtain", "animated": true, "sourceHandle": "right"}], "nodes": [{"id": "credits-hud", "data": {"text": "", "type": "setVariable", "start": true, "title": "（收起背包按鈕）", "variableOps": [{"id": "op-hud", "kind": "set", "value": false, "variable": "inventoryHudVisible"}]}, "type": "story", "position": {"x": 80, "y": 120}}, {"id": "credits-hall", "data": {"text": "燈暗下來。", "type": "scene", "stage": {"actors": [{"id": "actor-none", "url": "https://pub-4b20b43f5acf4dfaa3f6ab842daa51cf.r2.dev/2d3b0242-9a6d-4051-9825-46aa4efd064a/larch/project-bec1644c-0dfe-4447-86c0-0c592e2f939f/1787447653805_sprite-none.png", "loop": "none", "name": "", "slot": "center", "enter": "fade", "scale": 0.01, "offsetX": 0, "offsetY": 0}]}, "title": "放映廳", "background": "https://pub-4b20b43f5acf4dfaa3f6ab842daa51cf.r2.dev/2d3b0242-9a6d-4051-9825-46aa4efd064a/larch/project-bec1644c-0dfe-4447-86c0-0c592e2f939f/1787445225186_bg-credits-cinema-dim.png", "transition": "fade", "transitionMs": 900}, "type": "story", "position": {"x": 500, "y": 120}}, {"id": "credits-end", "data": {"text": "《格莉奇與黑洞先生・調查篇》完", "type": "dialogue", "stage": {"actors": [{"id": "actor-none", "url": "https://pub-4b20b43f5acf4dfaa3f6ab842daa51cf.r2.dev/2d3b0242-9a6d-4051-9825-46aa4efd064a/larch/project-bec1644c-0dfe-4447-86c0-0c592e2f939f/1787447653805_sprite-none.png", "loop": "none", "name": "", "slot": "center", "enter": "fade", "scale": 0.01, "offsetX": 0, "offsetY": 0}]}, "title": "完", "speaker": "旁白"}, "type": "story", "position": {"x": 920, "y": 120}}, {"id": "credits-roll", "data": {"text": "", "type": "miniGame", "title": "片尾字卷", "miniGameHtml": "<!doctype html>\n<html lang=\"zh-Hant\">\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>片尾字卷・調查篇</title>\n<!--\n  片尾字卷（design/調查篇-謝幕.md）。疊在放映廳那張場景圖上，自己不畫背景。\n  照正文 docs/credits.html 的字卷做，差別在中段照這一輪的變數排：\n  她記住的那一頁（page1_text）、她見過的人（met、met_*）、她去過的地方（visited）、幾個深夜（night_visits）。\n  miniGameReadVars：page1_text met visited day night_visits hole_sightings names_seen met_<每個人>\n  走完（或按平台的略過）就 larch:complete。\n-->\n<style>\n:root{--ink:#0b1a22;--hair:rgba(255,255,255,.07);--cy:#25c2e8;--mint:#7cf3c0;--purple:#b78bff;--text:#dfe8ec;--muted:#93a3ac;--faint:#6d7d84}\n*{box-sizing:border-box}\nhtml,body{height:100%;margin:0;background:#04080c;color:var(--text);overflow:hidden;\n  font-family:\"Noto Serif TC\",\"Songti TC\",\"PMingLiU\",Georgia,serif}\n#stage{position:fixed;inset:0;overflow:hidden;cursor:grab}\n/* 不靠平台把插件層畫成透明（有的裝置畫出來是白的）：自己鋪放映廳，壓暗，跟底下的場景圖是同一張，疊在一起也對得齊 */\n#hall{position:absolute;inset:0;z-index:0;pointer-events:none;background:var(--hall) center/cover no-repeat;opacity:.5}\n#stage::before{content:\"\";position:absolute;inset:0;z-index:1;pointer-events:none;\n  background:linear-gradient(180deg,rgba(4,8,12,.92) 0%,rgba(4,8,12,.3) 16%,rgba(4,8,12,.3) 84%,rgba(4,8,12,.92) 100%)}\n#track{position:absolute;left:50%;top:100%;z-index:2;width:min(92vw,720px);transform:translate(-50%,0);\n  text-align:center;text-shadow:0 1px 3px rgba(0,0,0,.85),0 0 18px rgba(0,0,0,.6);will-change:transform}\n.film{margin:14vh 0 0;font-size:38px;letter-spacing:.14em}\n.sub{margin:12px 0 0;font-size:13px;letter-spacing:.42em;color:var(--muted)}\n.h{margin:80px 0 22px;font-size:15px;letter-spacing:.5em;color:var(--cy);text-indent:.5em}\n.role{margin:44px 0 6px;font-size:12px;letter-spacing:.32em;color:var(--faint)}\n.name{font-size:22px;letter-spacing:.06em;line-height:1.6}\n.name small{display:block;font-size:12px;letter-spacing:.08em;color:var(--faint);margin-top:4px}\n.quip{margin:16px 0;font-size:16px;line-height:2;color:var(--muted)}\n.page{margin:0 auto;max-width:22em;text-align:left;font-size:17px;line-height:2.2;color:var(--text)}\n.page .id{color:var(--purple)} .page .who{margin-left:1em} .page .blank{color:var(--faint)}\n.cast{display:flex;flex-wrap:wrap;justify-content:center;gap:14px;max-width:640px;margin:0 auto}\n.c-card{width:112px}\n.c-card{background:rgba(11,26,34,.85);border:1px solid var(--hair);border-radius:3px;overflow:hidden}\n.c-pic{aspect-ratio:3/4;background:#060d12}\n.c-pic img{width:100%;height:100%;object-fit:cover;object-position:top center;display:block}\n.c-nm{padding:8px 4px 10px;font-size:15px;letter-spacing:.08em}\n.c-nm span{display:block;font-size:12px;color:var(--faint);letter-spacing:.04em}\n.epi{margin:88px auto 0;max-width:22em;font-size:21px;line-height:2.1;color:var(--mint)}\n.tail{height:40vh}\n@media (max-width:520px){.film{font-size:28px}.name{font-size:19px}.h{letter-spacing:.36em}}\n@media (prefers-reduced-motion:reduce){#track{transition:none}}\n</style>\n<div id=\"stage\"><div id=\"hall\" style=\"--hall:url(https://pub-4b20b43f5acf4dfaa3f6ab842daa51cf.r2.dev/2d3b0242-9a6d-4051-9825-46aa4efd064a/larch/project-bec1644c-0dfe-4447-86c0-0c592e2f939f/1787445225186_bg-credits-cinema-dim.png)\"></div><div id=\"track\">\n  <div class=\"film\">格莉奇與黑洞先生</div>\n  <div class=\"sub\">調 查 篇　・　十 四 天</div>\n\n  <div class=\"h\">她 記 住 的</div>\n  <div class=\"page\" id=\"page\"></div>\n\n  <div class=\"h\">她 見 過 的 人</div>\n  <div class=\"cast\" id=\"cast\"></div>\n  <div class=\"quip\" id=\"castNote\"></div>\n\n  <div class=\"h\">她 去 過 的 地 方</div>\n  <div class=\"name\" id=\"places\"></div>\n  <div class=\"quip\" id=\"nights\"></div>\n\n  <div class=\"role\">原作・劇本</div>\n  <div class=\"name\">林亞澤<small>調查篇，一百一十三段，她問了十四天</small></div>\n  <div class=\"role\">視覺・立繪・場景</div>\n  <div class=\"name\">AI 生成＋人工修版<small>去背、三檔色溫、站位校正</small></div>\n  <div class=\"role\">平台</div>\n  <div class=\"name\">Larch<small>larch.ink　視覺小說創作平台</small></div>\n\n  <div class=\"role\">致</div>\n  <div class=\"name\">每一個<br>一直去同一家店的人</div>\n  <div class=\"epi\" id=\"epi\">她被記住了，一點點。</div>\n  <div class=\"tail\"></div>\n</div></div>\n<script>\nvar values={};\nfunction finish(){ parent.postMessage({type:'larch:complete',result:'complete',payload:{}},'*'); }\nfunction list(v){ return String(v==null?'':v).split(/[,、]/).map(function(s){return s.trim();}).filter(Boolean); }\nfunction num(v){ var n=Number(v); return isNaN(n)||v===''||v==null?0:n; }\nfunction el(t,c,txt){ var e=document.createElement(t); if(c)e.className=c; if(txt!=null)e.textContent=txt; return e; }\nvar SPRITES={\"管理員\": \"https://pub-4b20b43f5acf4dfaa3f6ab842daa51cf.r2.dev/2d3b0242-9a6d-4051-9825-46aa4efd064a/larch/project-d2fea918-c0eb-4ab6-aefb-2fe9a75dc7c4/1788688765181_sprite-admin.png\", \"店員\": \"https://pub-4b20b43f5acf4dfaa3f6ab842daa51cf.r2.dev/2d3b0242-9a6d-4051-9825-46aa4efd064a/larch/project-d2fea918-c0eb-4ab6-aefb-2fe9a75dc7c4/1788688803015_sprite-clerk.png\", \"保全\": \"https://pub-4b20b43f5acf4dfaa3f6ab842daa51cf.r2.dev/2d3b0242-9a6d-4051-9825-46aa4efd064a/larch/project-d2fea918-c0eb-4ab6-aefb-2fe9a75dc7c4/1788688947212_sprite-guard.png\", \"老闆\": \"https://pub-4b20b43f5acf4dfaa3f6ab842daa51cf.r2.dev/2d3b0242-9a6d-4051-9825-46aa4efd064a/larch/project-d2fea918-c0eb-4ab6-aefb-2fe9a75dc7c4/1788688838442_sprite-parts.png\", \"櫃檯\": \"https://pub-4b20b43f5acf4dfaa3f6ab842daa51cf.r2.dev/2d3b0242-9a6d-4051-9825-46aa4efd064a/larch/project-d2fea918-c0eb-4ab6-aefb-2fe9a75dc7c4/1788688878072_sprite-reception.png\", \"諾亞\": \"https://pub-4b20b43f5acf4dfaa3f6ab842daa51cf.r2.dev/2d3b0242-9a6d-4051-9825-46aa4efd064a/larch/project-bec1644c-0dfe-4447-86c0-0c592e2f939f/1787387056919_sprite-noah.png\", \"斑比\": \"https://pub-4b20b43f5acf4dfaa3f6ab842daa51cf.r2.dev/2d3b0242-9a6d-4051-9825-46aa4efd064a/larch/project-bec1644c-0dfe-4447-86c0-0c592e2f939f/1787364891881_sprite-bambi.png\", \"鐵塔\": \"https://pub-4b20b43f5acf4dfaa3f6ab842daa51cf.r2.dev/2d3b0242-9a6d-4051-9825-46aa4efd064a/larch/project-bec1644c-0dfe-4447-86c0-0c592e2f939f/1787364955361_sprite-tower.png\", \"貓草\": \"https://pub-4b20b43f5acf4dfaa3f6ab842daa51cf.r2.dev/2d3b0242-9a6d-4051-9825-46aa4efd064a/larch/project-bec1644c-0dfe-4447-86c0-0c592e2f939f/1787364916321_sprite-catgrass.png\", \"0x\": \"https://pub-4b20b43f5acf4dfaa3f6ab842daa51cf.r2.dev/2d3b0242-9a6d-4051-9825-46aa4efd064a/larch/project-bec1644c-0dfe-4447-86c0-0c592e2f939f/1787364966161_sprite-zerox.png\", \"格莉奇\": \"https://pub-4b20b43f5acf4dfaa3f6ab842daa51cf.r2.dev/2d3b0242-9a6d-4051-9825-46aa4efd064a/larch/project-bec1644c-0dfe-4447-86c0-0c592e2f939f/1787364930429_sprite-glitch.png\", \"黑洞先生\": \"https://pub-4b20b43f5acf4dfaa3f6ab842daa51cf.r2.dev/2d3b0242-9a6d-4051-9825-46aa4efd064a/larch/project-bec1644c-0dfe-4447-86c0-0c592e2f939f/1787364905531_sprite-blackhole.png\"};\nvar LOC_NAME={\"lobby\": \"一樓\", \"roof\": \"頂樓收音機店\", \"street\": \"車站前那條街\", \"studio\": \"斑比工作室\", \"booth\": \"錄音間門口\", \"tower14\": \"十四樓大廳\", \"store\": \"便利商店\", \"parts\": \"材料行\", \"busstop\": \"車站前站牌\", \"metro\": \"南港站二號出口\", \"laundry\": \"自助洗衣店\", \"figure\": \"手辦店\"};\nvar DISPLAY={\"鐵塔\": \"經紀人\", \"貓草\": \"客人\", \"諾亞\": \"修收音機的\"};\nvar TAG={'管理員':'每天坐在那裡','諾亞':'話不多','斑比':'從來不打折','鐵塔':'從來不說再見','0x':'記錄精準','貓草':'只打字',\n  '店員':'第五次不說歡迎光臨','老闆':'等一顆管子','櫃檯':'請走公關窗口','保全':'這裡不能站','黑洞先生':'永遠在'};\nfunction render(){\n  // 一、她記住的那一頁：照 page1_text，第一行是旁白的開場，後面一行一個 ID\n  var pg=document.getElementById('page'); pg.textContent='';\n  var lines=String(values.page1_text||'').split('\\n');\n  if(lines.length>1){\n    lines.slice(1).forEach(function(l){ var i=l.indexOf('　'); var row=el('div');\n      row.appendChild(el('span','id', i>0?l.slice(0,i):l));\n      var who=i>0?l.slice(i+1):''; row.appendChild(el('span', who==='（　）'?'who blank':'who', who||'（　）')); pg.appendChild(row); });\n  } else { pg.appendChild(el('div','blank', lines[0]||'她一個字都沒有寫。')); }\n  // 二、她見過的人：met 的順序就是她遇到的順序\n  var cast=document.getElementById('cast'); cast.textContent='';\n  // 板上記的 met 只有在地點碰到的人；經紀人、0x、黑洞先生是在段落裡遇到的，看 met_* 與 hole_sightings\n  var ORDER=['管理員','諾亞','店員','材料行老闆','斑比','鐵塔','0x','貓草','櫃檯','保全','黑洞先生'];\n  var people=[]; list(values.met).forEach(function(p){ var q=(p==='老闆'?'材料行老闆':p); if(q && q!=='路人' && people.indexOf(q)<0) people.push(q); });\n  ORDER.forEach(function(q){ var k=(q==='黑洞先生')?num(values.hole_sightings):num(values['met_'+q]); if(k>0 && people.indexOf(q)<0) people.push(q); });\n  var n=0;\n  people.forEach(function(q){ var c=el('div','c-card'); var pic=el('div','c-pic'); var sp=SPRITES[q]||SPRITES[q==='材料行老闆'?'老闆':q];\n    if(sp){ var im=document.createElement('img'); im.src=sp; im.alt=q; im.loading='lazy'; pic.appendChild(im); }\n    c.appendChild(pic); var nm=el('div','c-nm',DISPLAY[q]||q); var k=(q==='黑洞先生')?num(values.hole_sightings):num(values['met_'+q]);\n    var tag=TAG[q]||TAG[q==='材料行老闆'?'老闆':q]||'';\n    nm.appendChild(el('span',null, k>0?((q==='黑洞先生'?'擦身而過 ':'見了 ')+k+' 次'+(tag?'・'+tag:'')):tag)); c.appendChild(nm); cast.appendChild(c); n++; });\n  document.getElementById('castNote').textContent = n? ('十四天，'+n+' 個人。'):'她誰都沒有見到。';\n  // 三、她去過的地方\n  var vis=list(values.visited).map(function(v){ return LOC_NAME[v]||v; });\n  document.getElementById('places').textContent = vis.length? vis.join('　'):'她哪裡都沒有去。';\n  var nv=num(values.night_visits), h=num(values.hole_sightings);\n  document.getElementById('nights').textContent = (nv?('深夜出門 '+nv+' 次。'):'')+(h?('在一樓遇到那個穿西裝的 '+h+' 次。'):'');\n  if(!(values.names_seen===true||values.names_seen==='true')) document.getElementById('epi').textContent='她做完了。';\n}\n// 字卷：從畫面一半開始往上走；滾輪、拖曳可以前後翻；走到底就完成\nvar stage=document.getElementById('stage'), track=document.getElementById('track');\nvar pos=innerHeight*0.5, last=0, dragY=null, done=false;\nvar SPEED=44, reduced=matchMedia('(prefers-reduced-motion:reduce)').matches;\nfunction maxPos(){ return track.scrollHeight+innerHeight*0.35; }\nfunction apply(){ track.style.transform='translate(-50%,'+(-pos)+'px)'; }\nfunction clamp(){ pos=Math.max(0,Math.min(maxPos(),pos)); }\nstage.addEventListener('wheel',function(e){ pos+=e.deltaY*0.7; clamp(); apply(); },{passive:true});\nstage.addEventListener('pointerdown',function(e){ dragY=e.clientY; stage.setPointerCapture(e.pointerId); });\nstage.addEventListener('pointermove',function(e){ if(dragY===null)return; pos+=(dragY-e.clientY)*1.1; dragY=e.clientY; clamp(); apply(); });\nstage.addEventListener('pointerup',function(){ dragY=null; }); stage.addEventListener('pointercancel',function(){ dragY=null; });\nfunction tick(t){ if(!last)last=t; var dt=(t-last)/1000; last=t;\n  if(dragY===null){ pos+=(reduced?SPEED*3:SPEED)*dt; }\n  if(pos>=maxPos() && !done){ done=true; clamp(); apply(); setTimeout(finish,600); return; }\n  clamp(); apply(); requestAnimationFrame(tick); }\nwindow.addEventListener('message',function(e){ var d=e.data; if(!d||d.type!=='larch:init')return;\n  values=Object.assign({}, d.variables||{}, d.values||{}); /* miniGame 的 init 給的是 variables；本機殼給 values，兩個都認 */ render(); apply(); requestAnimationFrame(tick); });\nparent.postMessage({type:'larch:ready'},'*');\n</script>\n</html>\n", "miniGameFrame": {"showTitle": false, "showButton": false}, "miniGameReadVars": ["page1_text", "met", "visited", "day", "night_visits", "hole_sightings", "names_seen", "met_管理員", "met_諾亞", "met_斑比", "met_鐵塔", "met_0x", "met_貓草", "met_店員", "met_材料行老闆", "met_櫃檯", "met_保全"], "miniGameSkippable": true, "miniGameWriteVars": [], "miniGamePresentation": "fullscreen"}, "type": "story", "position": {"x": 1340, "y": 120}}, {"id": "credits-bow", "data": {"text": "燈亮了。", "type": "scene", "stage": {"actors": [{"id": "actor-none", "url": "https://pub-4b20b43f5acf4dfaa3f6ab842daa51cf.r2.dev/2d3b0242-9a6d-4051-9825-46aa4efd064a/larch/project-bec1644c-0dfe-4447-86c0-0c592e2f939f/1787447653805_sprite-none.png", "loop": "none", "name": "", "slot": "center", "enter": "fade", "scale": 0.01, "offsetX": 0, "offsetY": 0}]}, "title": "謝幕", "background": "https://pub-4b20b43f5acf4dfaa3f6ab842daa51cf.r2.dev/2d3b0242-9a6d-4051-9825-46aa4efd064a/larch/project-d2fea918-c0eb-4ab6-aefb-2fe9a75dc7c4/1788792708155_bg-curtain-call-inv.jpg", "transition": "fade", "transitionMs": 700}, "type": "story", "position": {"x": 1760, "y": 120}}, {"id": "credits-line", "data": {"text": "逼——嗶！謝謝你看到這裡。\n這十四天你去了很多地方，問了很多人。\n他們記住你了，一點點。\n我也是。", "type": "dialogue", "stage": {"actors": [{"id": "actor-none", "url": "https://pub-4b20b43f5acf4dfaa3f6ab842daa51cf.r2.dev/2d3b0242-9a6d-4051-9825-46aa4efd064a/larch/project-bec1644c-0dfe-4447-86c0-0c592e2f939f/1787447653805_sprite-none.png", "loop": "none", "name": "", "slot": "center", "enter": "fade", "scale": 0.01, "offsetX": 0, "offsetY": 0}]}, "title": "格莉奇：謝謝你看到這裡", "speaker": "格莉奇"}, "type": "story", "position": {"x": 2180, "y": 120}}, {"id": "story-cg-unlock-curtain", "data": {"text": "新的調查篇紀念 CG 已加入收藏。", "type": "setVariable", "cgOps": [{"id": "op-story-cg-unlock-curtain-gallery", "url": "https://pub-4b20b43f5acf4dfaa3f6ab842daa51cf.r2.dev/2d3b0242-9a6d-4051-9825-46aa4efd064a/larch/project-d2fea918-c0eb-4ab6-aefb-2fe9a75dc7c4/1789531604248_cg-story-curtain-v2.webp", "mode": "unlock"}], "title": "解鎖：調查篇・謝幕"}, "type": "story", "position": {"x": 2480, "y": 300}}]}