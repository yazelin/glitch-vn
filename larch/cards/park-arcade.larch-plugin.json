      ],
      "html": "<!doctype html><html lang=\"zh-Hant\"><head><meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<style>\n  html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#10091d;\n    font-family:\"PingFang TC\",\"Microsoft JhengHei\",sans-serif}\n  #hub{position:absolute;inset:0;background-size:cover;background-position:center;\n    display:flex;align-items:flex-end;justify-content:center}\n  #hub::before{content:\"\";position:absolute;inset:0;\n    background:linear-gradient(180deg,rgba(10,8,20,0) 0%,rgba(10,8,20,.75) 55%,rgba(10,8,20,.92) 100%)}\n  #panel{position:relative;z-index:1;width:100%;max-width:520px;padding:0 24px 6vh;\n    box-sizing:border-box;color:#f2eefc}\n  #prompt{font-size:17px;margin:0 0 14px;text-shadow:0 2px 6px rgba(0,0,0,.6)}\n  #choices{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:10px}\n  #choices li{background:rgba(24,18,38,.62);border:1px solid rgba(184,164,255,.35);\n    border-radius:10px;padding:13px 16px;font-size:15px;cursor:pointer;\n    backdrop-filter:blur(2px);transition:background .15s,border-color .15s}\n  #choices li:active,#choices li:hover{background:rgba(120,90,220,.35);\n    border-color:rgba(210,196,255,.7)}\n  #choices li.leave{opacity:.75;margin-top:4px}\n  #gameWrap{position:absolute;inset:0;display:none}\n  #gameWrap iframe{width:100%;height:100%;border:0;display:block}\n</style>\n</head>\n<body>\n  <div id=\"hub\">\n    <div id=\"panel\">\n      <p id=\"prompt\"></p>\n      <ul id=\"choices\"></ul>\n    </div>\n  </div>\n  <div id=\"gameWrap\"><iframe id=\"game\" title=\"小遊戲\"></iframe></div>\n\n<script>\nvar values = {}, vars = {};\nvar hub = document.getElementById('hub');\nvar promptEl = document.getElementById('prompt');\nvar choicesEl = document.getElementById('choices');\nvar gameWrap = document.getElementById('gameWrap');\nvar gameFrame = document.getElementById('game');\n\nvar SLOTS = [];\nvar currentSlot = null;\nvar gameState = null;\nvar arcadeMusic = null, arcadeMusicUrl = '';\n\nfunction buildSlots() {\n  var list = [];\n  for (var i = 1; i <= 5; i++) {\n    var label = values['game' + i + 'Label'];\n    var url = values['game' + i + 'Url'];\n    if (!label || !url) continue;\n    list.push({\n      key: 'slot' + i,\n      label: label,\n      url: url,\n      protocol: values['game' + i + 'Protocol'] || ('slot' + i),\n      stateVar: values['game' + i + 'StateVar'] || '',\n      resultVar: values['game' + i + 'ResultVar'] || '',\n      incompleteVar: values['game' + i + 'IncompleteVar'] || ''\n    });\n  }\n  return list;\n}\n\nfunction music(d) {\n  if (d.url && (!arcadeMusic || arcadeMusicUrl !== d.url)) {\n    if (arcadeMusic) { arcadeMusic.pause(); arcadeMusic.removeAttribute('src'); }\n    arcadeMusicUrl = d.url;\n    arcadeMusic = new Audio(d.url);\n    arcadeMusic.loop = true;\n    arcadeMusic.preload = 'metadata';\n    arcadeMusic.volume = (typeof values.bgmVolume === 'number') ? values.bgmVolume : .27;\n  }\n  if (!arcadeMusic) return;\n  if (d.action === 'mute') { arcadeMusic.muted = !!d.muted; if (d.muted) arcadeMusic.pause(); }\n  if (d.action === 'play' && !d.muted) { arcadeMusic.muted = false; arcadeMusic.play().catch(function () {}); }\n}\n\nfunction startHubMusic() {\n  var bgmSrc = values.bgmUrl || values.bgm;\n  if (bgmSrc) music({ url: bgmSrc, action: 'play', muted: false });\n}\n\nfunction renderHub() {\n  promptEl.textContent = values.subtitle || '';\n  var bgSrc = values.backgroundUrl || values.background;\n  hub.style.backgroundImage = bgSrc ? \"url('\" + bgSrc + \"')\" : 'none';\n  choicesEl.innerHTML = '';\n  SLOTS.forEach(function (slot) {\n    var li = document.createElement('li');\n    li.textContent = slot.label;\n    li.dataset.slot = slot.key;\n    choicesEl.appendChild(li);\n  });\n  if (values.leaveLabel) {\n    var leaveLi = document.createElement('li');\n    leaveLi.className = 'leave';\n    leaveLi.textContent = values.leaveLabel;\n    leaveLi.dataset.leave = '1';\n    choicesEl.appendChild(leaveLi);\n  }\n}\n\nfunction showHub() {\n  currentSlot = null;\n  gameState = null;\n  gameFrame.src = 'about:blank';\n  gameWrap.style.display = 'none';\n  hub.style.display = 'flex';\n  startHubMusic();\n}\n\nfunction enterGame(key) {\n  var match = SLOTS.filter(function (s) { return s.key === key; });\n  var slot = match[0];\n  if (!slot) return;\n  currentSlot = slot;\n  var raw = slot.stateVar ? vars[slot.stateVar] : '';\n  try { gameState = raw ? JSON.parse(raw) : null; } catch (err) { gameState = null; }\n  if (arcadeMusic) arcadeMusic.pause();\n  hub.style.display = 'none';\n  gameWrap.style.display = 'block';\n  gameFrame.title = slot.label;\n  gameFrame.src = slot.url;\n}\n\nfunction leaveArcade() {\n  if (arcadeMusic) arcadeMusic.pause();\n  if (values.leaveResultVar) {\n    parent.postMessage({ type: 'larch:set', name: values.leaveResultVar, value: true }, '*');\n  }\n  setTimeout(function () {\n    parent.postMessage({ type: 'larch:complete', result: 'exit', payload: {} }, '*');\n  }, 150);\n}\n\nchoicesEl.addEventListener('click', function (e) {\n  var li = e.target.closest('li');\n  if (!li) return;\n  if (li.dataset.leave) { leaveArcade(); return; }\n  if (li.dataset.slot) { enterGame(li.dataset.slot); }\n});\n\nparent.postMessage({ type: 'larch:ready' }, '*');\n\nwindow.addEventListener('message', function (e) {\n  var d = e.data;\n  if (!d || !d.type) return;\n\n  if (d.type === 'larch:init') {\n    values = d.values || {};\n    vars = d.variables || {};\n    SLOTS = buildSlots();\n    renderHub();\n    showHub();\n    return;\n  }\n\n  if (e.source !== gameFrame.contentWindow) return;\n\n  if (d.type === 'glitch-park:music') { music(d); return; }\n  if (!currentSlot) return;\n\n  if (d.type === currentSlot.protocol + ':ready') {\n    gameFrame.contentWindow.postMessage({ type: currentSlot.protocol + ':state', state: gameState }, '*');\n    return;\n  }\n  if (d.type === currentSlot.protocol + ':save') {\n    gameState = d.state;\n    if (currentSlot.stateVar) {\n      parent.postMessage({ type: 'larch:set', name: currentSlot.stateVar, value: JSON.stringify(gameState) }, '*');\n    }\n    return;\n  }\n  if (d.type === currentSlot.protocol + ':exit') {\n    if (arcadeMusic) arcadeMusic.pause();\n    var complete = !!d.complete;\n    var slot = currentSlot;\n    if (slot.resultVar) {\n      parent.postMessage({ type: 'larch:set', name: slot.resultVar, value: complete }, '*');\n    }\n    /* 未集齊用獨立變量，不是讓下游去問 resultVar==false：沒玩過的那幾款預設就是 false，\n       那樣接會被別款的離開事件一起觸發。兩個變量永遠一真一假。 */\n    if (slot.incompleteVar) {\n      parent.postMessage({ type: 'larch:set', name: slot.incompleteVar, value: !complete }, '*');\n    }\n    setTimeout(function () {\n      parent.postMessage({ type: 'larch:complete', result: 'exit', payload: { slot: slot.key, complete: complete } }, '*');\n    }, 240);\n  }\n});\n</script>\n</body></html>\n"
    }
  ]
}
